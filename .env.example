# =============================================================================
# Copy this file to `.env` and fill in the values.
#
#   cp .env.example .env          # macOS / Linux
#   Copy-Item .env.example .env   # Windows PowerShell
#
# Or just run `infra/provision.ps1` (or `infra/provision.sh`) - it creates the
# Azure resources AND writes a ready-to-use `.env` for you.
#
# `.env` is git-ignored. Never commit real credentials.
#
# -----------------------------------------------------------------------------
# This repo ships the same agent twice. Sections 1 and 2 are shared; then fill
# in section 3 OR section 4, depending on which implementation you want to run:
#
#   src/maf/       Microsoft Agent Framework     -> needs section 3
#   src/foundry/   Foundry Agent Service         -> needs section 4
#
# You do not have to configure both. See docs/implementations.md.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Azure Database for PostgreSQL (the "hands" of the agent) - BOTH
# -----------------------------------------------------------------------------
#
# ANY PostgreSQL server works - Azure, on-premises, Docker, RDS, Neon, Supabase.
# It does not have to be the one the provisioning script creates.
# See docs/bring-your-own.md.

PGHOST=<your-server>.postgres.database.azure.com
PGPORT=5432
PGDATABASE=fiberops
PGUSER=fiberadmin
PGPASSWORD=<your-password>

# `require` is mandatory on Azure - the service refuses non-TLS connections.
# Use `disable` for a local Docker Postgres, `prefer` if you are unsure.
PGSSLMODE=require

# -----------------------------------------------------------------------------
# 2. Postgres MCP Server behaviour - BOTH
# -----------------------------------------------------------------------------

# unrestricted -> the agent can INSERT / UPDATE / DELETE / DDL. Needed for this
#                 demo, which is about *writing* as well as reading.
# restricted   -> read-only transactions only. Safer; use it in shared or
#                 production-like databases.
POSTGRES_MCP_ACCESS_MODE=unrestricted

# never_require  -> tools run without asking you. Convenient for a demo.
# always_require -> you approve every single tool call.
#                   See src/maf/examples/human_approval.py.
#                   Agent Framework only; the Foundry variant ignores it.
POSTGRES_MCP_APPROVAL_MODE=never_require

# Uncomment if `uvx` cannot reach PyPI - typically corporate TLS inspection,
# which shows up as "MCP server ... failed to initialize: Connection closed".
# Requires the package to already be in uv's cache, so run it once on a network
# that works. Implementation 1 only; implementation 2 never starts a process.
# UV_OFFLINE=1

# -----------------------------------------------------------------------------
# 3. Azure OpenAI - IMPLEMENTATION 1 ONLY (src/maf/)
# -----------------------------------------------------------------------------
#
# Leave these empty if you only want to run the Foundry Agent Service variant.

# The Azure OpenAI endpoint of your Foundry / Azure OpenAI resource.
# Must be the *openai.azure.com* form, not the *services.ai.azure.com* one.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/

# The name of your *deployment* (not the underlying model name). In the Foundry
# portal this is the "Deployment name" column. Any tool-calling capable model
# works; gpt-4.1 and gpt-4.1-mini are good defaults.
AZURE_OPENAI_DEPLOYMENT=gpt-4.1

# API version. Leave this EMPTY unless you have a specific reason not to.
#
# Agent Framework uses the Azure OpenAI *Responses* API. Older api-versions
# (2024-10-21, 2025-04-01-preview, ...) do not support it and fail with
# "400 BadRequest: API version not supported". An empty value lets the SDK pick
# a compatible default, which is what you want.
AZURE_OPENAI_API_VERSION=

# OPTIONAL. Leave this empty to authenticate with Entra ID (`az login`), which
# is the recommended path. Only set it if you cannot use Entra ID.
# AZURE_OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# 4. Microsoft Foundry - IMPLEMENTATION 2 ONLY (src/foundry/)
# -----------------------------------------------------------------------------
#
# Leave these empty if you only want to run the Agent Framework variant.
#
# Full walkthrough: docs/implementations.md

# The *project* endpoint, not the Azure OpenAI one. Foundry portal -> your
# project -> Overview. Note it ends with /api/projects/<project-name>.
# FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>

# The name the agent gets in the project. Syncing again under the same name
# creates a new version rather than a second agent. Defaults to fiberops-agent.
# FOUNDRY_AGENT_NAME=fiberops-agent

# A model deployment that exists in the SAME resource as the project above.
# This is the deployment name, not the model name.
# FOUNDRY_MODEL_DEPLOYMENT=gpt-4.1

# The two below are written for you by `pwsh infra/deploy-mcp.ps1`, which
# publishes the Postgres MCP server and stores its credential in a Foundry
# project connection. Do not fill them in by hand.
#
# The Agent Service calls this endpoint itself, so it must be reachable from
# Azure - a local address will not do.
# MCP_SERVER_URL=https://<app>.<region>.azurecontainerapps.io/mcp
#
# The project connection holding that endpoint's credential. The agent
# references it by name; the secret never enters the agent definition, which
# the Agent Service enforces rather than merely recommends.
# MCP_CONNECTION_NAME=postgres-mcp

# -----------------------------------------------------------------------------
# 5. Using your own database (optional) - BOTH
# -----------------------------------------------------------------------------
#
# By default the agent uses a built-in system prompt describing the FiberOps
# telecom sample schema. If you point PGHOST/PGDATABASE above at your own
# database, that prompt is wrong and the agent will be confused.
#
# Set this to a file describing YOUR schema. Two ready-made options ship in the
# prompts/ folder:
#
#   prompts/auto-discover-schema.md  the agent inspects your schema at run time.
#                                    Works anywhere, zero effort, slightly
#                                    slower and less precise.
#
#   prompts/template.md              copy it, describe your tables, and point
#                                    this variable at your copy. Best results.
#
# Both implementations read it.
#
# Full walkthrough: docs/bring-your-own.md
#
# AGENT_INSTRUCTIONS_FILE=prompts/auto-discover-schema.md
